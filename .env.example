# Copy this file to ".env" (same folder) and fill in the values.
# docker-compose.yml reads these automatically.

# REQUIRED — a long random secret for signing login sessions.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=

# PostgreSQL (runs in a container; data lives in the "pgdata" volume).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=employee_movement_ai

# Host port the app is served on.
PORT=4000

# The URL people use to reach the app.
#   - this machine only:  http://localhost:4000
#   - other devices on the LAN: the server's IP, e.g. http://192.168.1.50:4000
APP_URL=http://localhost:4000

# Session-cookie Secure flag.
#   - false  → plain HTTP (localhost or LAN IP). Required for LAN login to work.
#   - true   → only when the app is served over HTTPS (e.g. behind a tunnel).
COOKIE_SECURE=false

# First boot on a FRESH database: set SEED_ON_START=true to create the admin user
# and default signatories/template, then set it back to false and re-run.
SEED_ON_START=false
SEED_ADMIN_EMAIL=admin@itmg.co.id
SEED_ADMIN_PASSWORD=ChangeMe123!
